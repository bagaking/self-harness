+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+WORK_DIR="${ROOT_DIR}/.self-harness/tmp/supervisor-notify-cycle-check"
+
+fail() {
+  echo "supervisor-notify-cycle-check: $*" >&2
+  exit 1
+}
+
+log() {
+  echo "supervisor-notify-cycle-check: $*"
+}
+
+write_fake_codex() {
+  local dir="$1"
+  mkdir -p "$dir"
+  cat >"${dir}/codex" <<'EOF'
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo=""
+output=""
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    --cd)
+      shift
+      repo="${1:-}"
+      ;;
+    --output-last-message)
+      shift
+      output="${1:-}"
+      ;;
+  esac
+  shift || break
+done
+
+[ -n "$repo" ] || repo="$(pwd)"
+cd "$repo"
+mkdir -p .self-harness/tmp
+printf 'fake codex invoked\n' >>.self-harness/tmp/fake-codex-invocations.log
+
+if [ -n "$output" ]; then
+  mkdir -p "$(dirname "$output")"
+  printf 'Completed fake notify cycle\n' >"$output"
+fi
+
+exit 42
+EOF
+  chmod +x "${dir}/codex"
+}
+
+write_fake_lark_cli() {
+  local dir="$1"
+  mkdir -p "$dir"
+  cat >"${dir}/lark-cli" <<'EOF'
+#!/usr/bin/env bash
+{
+  printf 'argc=%s\n' "$#"
+  i=0
+  for arg in "$@"; do
+    i=$((i + 1))
+    printf 'arg_%02d=%s\n' "$i" "$arg"
+  done
+} >>"${SELF_HARNESS_FAKE_LARK_LOG:?}"
+exit 0
+EOF
+  chmod +x "${dir}/lark-cli"
+}
+
+prepare_sandbox() {
+  local sandbox="$1"
+  mkdir -p \
+    "${sandbox}/bin" \
+    "${sandbox}/constitution" \
+    "${sandbox}/scripts" \
+    "${sandbox}/mailbox/inbox" \
+    "${sandbox}/mailbox/processing" \
+    "${sandbox}/mailbox/outbox" \
+    "${sandbox}/mailbox/done" \
+    "${sandbox}/mailbox/failed" \
+    "${sandbox}/memory/diary" \
+    "${sandbox}/memory/decisions" \
+    "${sandbox}/memory/lessons" \
+    "${sandbox}/memory/proposals" \
+    "${sandbox}/memory/incidents" \
+    "${sandbox}/sessions" \
+    "${sandbox}/skills"
+
+  cp "${ROOT_DIR}/.gitignore" "${sandbox}/.gitignore"
+  cp "${ROOT_DIR}/AGENTS.md" "${sandbox}/AGENTS.md"
+  cp "${ROOT_DIR}/constitution/"*.md "${sandbox}/constitution/"
+  cp "${ROOT_DIR}/scripts/"*.sh "${sandbox}/scripts/"
+  chmod +x "${sandbox}/scripts/"*.sh
+  write_fake_codex "${sandbox}/bin"
+  write_fake_lark_cli "${sandbox}/bin"
+
+  git -C "$sandbox" init -q
+  git -C "$sandbox" checkout -q -b agent/no0_self_imporve
+}
+
+main() {
+  local sandbox log_file fake_lark_log status invocation_count
+  mkdir -p "$WORK_DIR"
+  sandbox="$(mktemp -d "${WORK_DIR}/run.XXXXXX")"
+  log_file="${sandbox}/cycle.log"
+  fake_lark_log="${sandbox}/fake-lark.log"
+
+  prepare_sandbox "$sandbox"
+
+  set +e
+  (
+    cd "$sandbox"
+    env \
+      PATH="${sandbox}/bin:${PATH}" \
+      SELF_HARNESS_AUTO_CHALLENGE=0 \
+      SELF_HARNESS_SKIP_COMMIT=1 \
+      SELF_HARNESS_CODEX_MAX_RUNTIME_SECONDS=0 \
+      SELF_HARNESS_CODEX_IDLE_TIMEOUT_SECONDS=0 \
+      SELF_HARNESS_FAKE_LARK_LOG="$fake_lark_log" \
+      SELF_HARNESS_NOTIFY_LARK_BIN="lark-cli" \
+      SELF_HARNESS_NOTIFY_CHAT_ID="cycle-proof-chat" \
+      bash scripts/supervisor.sh once
+  ) >"$log_file" 2>&1
+  status=$?
+  set -e
+
+  [ "$status" -eq 42 ] || {
+    sed -n '1,220p' "$log_file" >&2
+    fail "expected supervisor once to return fake Codex status 42, got ${status}"
+  }
+
+  invocation_count="$(wc -l <"${sandbox}/.self-harness/tmp/fake-codex-invocations.log" | tr -d '[:space:]')"
+  [ "$invocation_count" = "1" ] || fail "expected exactly one fake Codex invocation, got ${invocation_count}"
+
+  LC_ALL=C rg -q 'event=start' "${sandbox}/.self-harness/run/supervisor-status.log" || fail "status log missed start event"
+  LC_ALL=C rg -q 'status=running' "${sandbox}/.self-harness/run/supervisor-status.log" || fail "status log missed running state"
+  LC_ALL=C rg -q 'event=failure' "${sandbox}/.self-harness/run/supervisor-status.log" || fail "status log missed failure event"
+  LC_ALL=C rg -q 'status=failed' "${sandbox}/.self-harness/run/supervisor-status.log" || fail "status log missed failed state"
+  LC_ALL=C rg -q 'branch=agent/no0_self_imporve' "${sandbox}/.self-harness/run/supervisor-status.log" || fail "status log missed no0 branch"
+
+  [ -f "$fake_lark_log" ] || fail "fake lark-cli was not invoked"
+  LC_ALL=C rg -q 'arg_[0-9]+=cycle-proof-chat' "$fake_lark_log" || fail "fake lark log missed configured chat id"
+  LC_ALL=C rg -q 'Event: start' "$fake_lark_log" || fail "fake lark log missed start event"
+  LC_ALL=C rg -q 'Event: failure' "$fake_lark_log" || fail "fake lark log missed failure event"
+  LC_ALL=C rg -q -- '--- supervisor for @no\.0\|agent/no0_self_imporve' "$fake_lark_log" || fail "fake lark log missed no0 supervisor signature"
+
+  log "checked-out supervisor once emitted start and failure notification events through fake lark-cli"
+  log "ok"
+}
+
+main "$@"
